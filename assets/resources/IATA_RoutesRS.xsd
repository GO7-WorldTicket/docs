<?xml version="1.0" encoding="UTF-8"?>
<!--
    GO7 extension of IATA NDC 21.3.5 (not part of the IATA standard).
    Routes response built from standard IATA_OffersAndOrdersCommonTypes types.
-->
<xs:schema targetNamespace="http://www.iata.org/IATA/2015/EASD/00/IATA_OffersAndOrdersMessage"
           elementFormDefault="qualified"
           version="1.000"
           xmlns:cns="http://www.iata.org/IATA/2015/EASD/00/IATA_OffersAndOrdersCommonTypes"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.iata.org/IATA/2015/EASD/00/IATA_OffersAndOrdersMessage">
    <xs:import namespace="http://www.iata.org/IATA/2015/EASD/00/IATA_OffersAndOrdersCommonTypes"
               schemaLocation="IATA_OffersAndOrdersCommonTypes.xsd"/>

    <xs:element name="IATA_RoutesRS">
        <xs:annotation>
            <xs:documentation>The Routes transaction returns the routes (origin and destination airport pairs) operated by the requested carriers.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:choice minOccurs="1" maxOccurs="1">
                    <xs:element name="Error" type="cns:ErrorType" minOccurs="1" maxOccurs="unbounded">
                        <xs:annotation>
                            <xs:documentation>Contains information related to errors detected during processing of the preceding request.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element name="Response" type="RoutesResponseType" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                            <xs:documentation>Routes RS response information.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:choice>
                <xs:element name="PayloadAttributes" type="cns:IATA_PayloadStandardAttributesType" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation>IATA standard payload attributes.</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="RoutesResponseType">
        <xs:sequence>
            <xs:element name="DataLists" type="cns:DataListsType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Routes as OriginDestList/OriginDest entries, one per origin and destination airport pair.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Warning" type="cns:WarningType" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>Contains information related to warnings detected during processing of the preceding request.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>
